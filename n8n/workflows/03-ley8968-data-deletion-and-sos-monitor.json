        "url": "https://backend.example.invalid/api/notifications/outbox/process",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"batch_size\":10}"
      },
      "position": [
        840,
        100
      ]
