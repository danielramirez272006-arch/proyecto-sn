# ==============================================================================
# Sinergia Urbana Costa Rica — Variables de Conexión a Supabase Cloud
# Proyecto: hnnnreowlbtqqjhpmdvd
# URL: https://hnnnreowlbtqqjhpmdvd.supabase.co
# ==============================================================================

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Motor de Base de Datos: 'postgres' para Supabase, con fallback automático a SQLite
DB_DIALECT=postgres

# Supabase Auth & REST API (Project Settings -> API)
SUPABASE_URL=https://hnnnreowlbtqqjhpmdvd.supabase.co
# Clave anónima / publishable key para validar identidad de usuarios con Supabase Auth
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Clave administrativa Service Role (estrictamente privada en backend/.env, nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de Conexión PostgreSQL (URI de Connect con credencial limitada para la app)
# Consíguela en: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Modo Pooler (Transaction, puerto 6543) o Directo (puerto 5432)
# El esquema app_private se selecciona automáticamente vía search_path=app_private,public
# Ejemplo:
DATABASE_URL=postgresql://postgres.hnnnreowlbtqqjhpmdvd:[TU_PASSWORD_AQUI]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=

# Seguridad y Autenticación Interna
JWT_SECRET=super_secret_jwt_key_costa_rica_synergy_2026
SESSION_COOKIE_NAME=sn_session

# DeepSeek AI Copilot (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2

