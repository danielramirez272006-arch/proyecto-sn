      "typeVersion": 2,
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\nif (data?.valid !== true) throw new Error('La verificación de auditoría falló. Revisar GoToX antes de despachar.');\nreturn [{json:{auditValid:true}}];"
      },
      "position": [
        560,
        100
      ]
    },
