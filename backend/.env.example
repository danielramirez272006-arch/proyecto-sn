# Server Environment Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MySQL 8+ compatible, Supabase PostgreSQL, with SQLite test fallback)
DB_DIALECT=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sn_db
DB_NAME_TEST=sn_db_test

# Supabase Cloud Configuration (https://supabase.com/dashboard)
# Consíguelos en: Project Settings -> API & Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URI Directa PostgreSQL de Supabase (opcional para conexión de base de datos directa)
SUPABASE_DB_URL=

# Auth & Security
JWT_SECRET=super_secret_jwt_key_costa_rica_synergy_2026
SESSION_COOKIE_NAME=sn_session

# External AI & Webhooks (DeepSeek & Google Gemini)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
WEBHOOK_URL=http://localhost:5678/webhook/test

# YouTube Data API v3 (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# Open APIs Costa Rica & Open Data (100% Free / No Credit Card)
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
RAINVIEWER_BASE_URL=https://api.rainviewer.com/public/weather-maps.json
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HACIENDA_API_URL=https://api.hacienda.go.cr/fe/ae
RECOPE_API_URL=https://api.recope.go.cr/combustibles/precios
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
NAGER_DATE_URL=https://date.nager.at/api/v3/PublicHolidays
