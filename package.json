{
  "name": "sn-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo raíz para Sistema de Sinergia Urbana",
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:all": "node scripts/dev-all.js",
    "dev:backend": "cd backend && npm run dev",
