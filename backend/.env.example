# ==============================================================================
# Synodos Pet OS — Plantilla de Variables de Entorno para Producción (Render)
# Copiar a backend/.env en local o cargar en Render -> Environment
# NUNCA subir valores reales a GitHub
# ==============================================================================

NODE_ENV=production
PORT=4000
TRUST_PROXY=true

# URL pública del sitio en Render o dominio propio (soporta múltiples separadas por coma)
FRONTEND_URL=https://synodos-pet-os.onrender.com

# Seguridad criptográfica (generar secretos aleatorios de 64+ caracteres hex)
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_64_HEX
PASSWORD_PEPPER=REEMPLAZAR_CON_PEPPER_ALEATORIO_64_HEX
BCRYPT_ROUNDS=12

# Supabase (PostgreSQL + Storage público/privado)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=REEMPLAZAR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres.TU_PROYECTO:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_PHOTO_PUBLIC_BUCKET=gotox-place-photos-public
SUPABASE_PHOTO_PRIVATE_BUCKET=gotox-place-photos-private

# Google Gemini AI (Copiloto Argos, 8 Agentes IA y Pre-Triaje Visual)
GEMINI_API_KEY=REEMPLAZAR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DAILY_QUOTA=1500

# Cuenta administradora inicial (bootstrap seguro al arrancar)
ADMIN_EMAIL=admin@gotox.cr
ADMIN_PASSWORD=REEMPLAZAR_CLAVE_ADMIN_SEGURA

# Correo transaccional vía Brevo (https://app.brevo.com — 300 correos/día gratis)
# Sin BREVO_API_KEY el backend funciona en modo local sin fallar.
# Al agregar BREVO_API_KEY y un remitente verificado, /api/auth/forgot-password envía correos reales automáticamente.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@synodos.cr
BREVO_SENDER_NAME=Synodos Pet OS
BREVO_RESET_TEMPLATE_ID=1
# BREVO_REPLY_TO=soporte@synodos.cr

# Escalado futuro (opcional: solo si algún día corren múltiples instancias de Render en paralelo)
# REDIS_URL=redis://default:PASSWORD@HOST:6379
