        "url": "https://backend.example.invalid/api/audit/verify-chain",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "position": [
        280,
        100
      ]
