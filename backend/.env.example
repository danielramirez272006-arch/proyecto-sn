# Server Environment Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MySQL 8+ compatible, Supabase PostgreSQL, with SQLite test fallback)
DB_DIALECT=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sn_db
DB_NAME_TEST=sn_db_test

# Supabase Cloud Configuration (https://supabase.com/dashboard)
# Consíguelos en: Project Settings -> API & Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URI Directa PostgreSQL de Supabase (opcional para conexión de base de datos directa)
SUPABASE_DB_URL=

# Auth & Security
JWT_SECRET=super_secret_jwt_key_costa_rica_synergy_2026
SESSION_COOKIE_NAME=sn_session

# External AI & Webhooks (DeepSeek & Google Gemini)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
WEBHOOK_URL=http://localhost:5678/webhook/test

# YouTube Data API v3 (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# Open APIs Costa Rica & Open Data (100% Free / No Credit Card)
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
RAINVIEWER_BASE_URL=https://api.rainviewer.com/public/weather-maps.json
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HACIENDA_API_URL=https://api.hacienda.go.cr/fe/ae
RECOPE_API_URL=https://api.recope.go.cr/combustibles/precios
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
NAGER_DATE_URL=https://date.nager.at/api/v3/PublicHolidays
RADIO_BROWSER_URL=https://de1.api.radio-browser.info/json/stations/bycountry/costa%20rica

# ElevenLabs TTS (Voz de Copiloto Bruno)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=3mmJ2Z5SLZ9OkeZZcv5p
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Google Places API (New) - Solo backend, nunca exponer en frontend
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_INCLUDE_ATMOSPHERE=false
GOOGLE_PLACES_TIMEOUT_MS=7000

# Foursquare Places API (Solo operaciones gratuitas salvo habilitación explícita)
FOURSQUARE_ENABLED=false
FOURSQUARE_ALLOW_PAID=false
FOURSQUARE_API_KEY=
FOURSQUARE_API_VERSION=2025-06-17
FOURSQUARE_TIMEOUT_MS=7000
FOURSQUARE_MAX_PER_MIN=20
FOURSQUARE_MAX_CONCURRENCY=2

# Geoapify Places API v2 (Solo backend, cuota gratuita)
GEOAPIFY_ENABLED=false
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_MS=7000
GEOAPIFY_MAX_PER_MIN=30
GEOAPIFY_MAX_CONCURRENCY=2

# OpenStreetMap (Nominatim/Photon) y Wikimedia Commons (Gratuitos sin clave)
OSM_PLACES_ENABLED=true
OSM_PLACES_TIMEOUT_MS=8000
WIKIMEDIA_PHOTOS_ENABLED=true
WIKIMEDIA_TIMEOUT_MS=6000

# Pipeline de Fotografías en Supabase Storage (Solo backend)
SUPABASE_PHOTO_PRIVATE_BUCKET=gotox-place-photos-private
SUPABASE_PHOTO_PUBLIC_BUCKET=gotox-place-photos-public
PHOTO_MAX_BYTES=8388608
PHOTO_MIN_WIDTH=400
PHOTO_MIN_HEIGHT=300
PHOTO_BATCH_CONCURRENCY=2
PHOTO_SIGNED_URL_TTL_SEC=300
PHOTO_ALLOWED_EXTERNAL_HOSTS=upload.wikimedia.org,commons.wikimedia.org

